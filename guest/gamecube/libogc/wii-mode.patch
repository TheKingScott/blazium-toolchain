 	0x00000000,0x00000000,0x00000021,0x02ff0021,
@@ -181,6 +184,17 @@ static u32 _cardunlockdata[0x160] ATTRIBUTE_ALIGN(32) =
 };
 #endif
 
+#if defined(HW_RVL)
+#define _cardunlockdata _cardunlockdata_rvl
+#define CARD_UNLOCK_MEM_BASE 0x10000000 // MEM2
+#else
+#include <tuxedo/mm.h>
