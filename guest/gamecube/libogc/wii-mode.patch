diff --git a/gc/tuxedo/mm.h b/gc/tuxedo/mm.h
index a5a3e5e..74a0117 100644
--- a/gc/tuxedo/mm.h
+++ b/gc/tuxedo/mm.h
@@ -23,7 +23,11 @@
 #define MM_P_MEM2   0x10000000
 #define MM_MEM2_SZ  0x04000000
 #else
-#define MM_P_IO_PPC 0x0c000000
+/* A GameCube program can find itself on a Wii in Wii mode (Nintendont runs
+ * GameCube games so): there DI, SI, EXI and AI answer at 0x0d006000, not at
+ * 0x0c006000. The loader leaves the bus clock at 0x800000f8: 243 MHz on a
+ * Wii, 162 MHz on a GameCube (and in Dolphin). */
+#define MM_P_IO_PPC (*(volatile unsigned int *)0x800000f8 == 243000000u ? 0x0d000000u : 0x0c000000u)
 #endif
 
 #define MM_V_CACHED   0x80000000
