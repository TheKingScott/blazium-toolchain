+#define CARD_ON_WII (*(volatile unsigned int *)0x800000f8 == 243000000u)
+#define _cardunlockdata (CARD_ON_WII ? _cardunlockdata_rvl : _cardunlockdata_dol)
+#define CARD_UNLOCK_MEM_BASE (CARD_ON_WII ? 0x10000000 : 0) // MEM2, or ARAM
+#endif
