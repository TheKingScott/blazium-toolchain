; The pixel shader: the GS's MODULATE (texture times vertex colour, RGB
; only) and its FOG (fog.rgb the fog colour, fog.a how much of the surface
; is left: 1 no fog); alpha is the vertex's (the fade's blend).
; Inputs: R0 colour, R1 fog, R2 uv.
; $MODE = "UniformRegister"
; $SAMPLER_VARS[0].NAME = "tex"
; $SAMPLER_VARS[0].TYPE = "sampler2D"
; $SAMPLER_VARS[0].LOCATION = 0
; $SQ_PGM_RESOURCES_PS.NUM_GPRS = 4
; $SQ_PGM_RESOURCES_PS.STACK_SIZE = 0
; $SPI_PS_IN_CONTROL_0.NUM_INTERP = 3
; $NUM_SPI_PS_INPUT_CNTL = 3
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[2].SEMANTIC = 2
; $SPI_PS_INPUT_CNTL[2].DEFAULT_VAL = 1

00 TEX: ADDR(48) CNT(1) VALID_PIX
   0 SAMPLE R3, R2.xy0x, t0, s0
01 ALU: ADDR(32) CNT(9)
   1 x: MUL R3.x, R3.x, R0.x
     y: MUL R3.y, R3.y, R0.y
     z: MUL R3.z, R3.z, R0.z
   2 x: ADD R3.x, R3.x, -R1.x
     y: ADD R3.y, R3.y, -R1.y
     z: ADD R3.z, R3.z, -R1.z
   3 x: MULADD R0.x, R3.x, R1.w, R1.x
     y: MULADD R0.y, R3.y, R1.w, R1.y
     z: MULADD R0.z, R3.z, R1.w, R1.z
02 EXP_DONE: PIX0, R0.xyzw
END_OF_PROGRAM
