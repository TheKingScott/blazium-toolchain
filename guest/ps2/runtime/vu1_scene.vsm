; MIT. Blazium PS2 guest: VU1 scene microprogram (vu1_draw.cpp).
;
; One batch of up to 72 vertices (24 triangles) per run, double buffered by
; the VIF (BASE 8, OFFSET 496): the EE's DMA chain unpacks a batch into one
; buffer while this runs on the other. Every input is at TOP:
;
;   TOP+0..3   MVP columns. The z row is (0,0,0,1), so z/w comes out as 1/w.
;   TOP+4      scale  (w/2, -h/2, zmax/4, 0)      zmax/4: 0.25/w * 2^24
;   TOP+5      offset (2048, 2048, 0, 0)
;   TOP+6      fog    (a, b, 255, 0): F = clamp(w*a + b, 0, 255)
;   TOP+7      GIF tag: PACKED ST, RGBAQ, XYZF2, NLOOP = n, EOP, PRIM;
;              its w word (REGS 8..15, unused) holds n
;   TOP+8      n positions (x, y, z, 1)
;   then       n texture coordinates (u, v, 1, 0)
;   then       n colours, one byte per word (0..128)
;
; Out, after the input: the GIF tag, then per vertex STQ, RGBA, XYZF2, then
; XGKICK. No clipping: the EE only sends chunks that are in front of the
; near plane and inside the GS guard band; the rest go through its own
; clipper.
;
; Hazards: FMAC results interlock in hardware. Q does not, hence WAITQ.
; Integer loads and the loop counter get a spare instruction before use.

		.vu
		.align 4
		.global	VU1Scene_CodeStart
		.global	VU1Scene_CodeEnd
VU1Scene_CodeStart:
         NOP                                    xtop          VI02
         NOP                                    NOP
         NOP                                    lq            VF01,0(VI02)
         NOP                                    lq            VF02,1(VI02)
         NOP                                    lq            VF03,2(VI02)
         NOP                                    lq            VF04,3(VI02)
         NOP                                    lq            VF05,4(VI02)
         NOP                                    lq            VF06,5(VI02)
         NOP                                    lq            VF11,6(VI02)
         NOP                                    lq            VF12,7(VI02)
         NOP                                    ilw.w         VI09,7(VI02)
         NOP                                    iaddiu        VI03,VI02,8
         NOP                                    NOP
         NOP                                    NOP
         NOP                                    NOP
         NOP                                    iadd          VI04,VI03,VI09
         NOP                                    NOP
         NOP                                    iadd          VI05,VI04,VI09
         NOP                                    NOP
         NOP                                    iadd          VI06,VI05,VI09
         NOP                                    NOP
         NOP                                    iaddiu        VI08,VI06,0
         NOP                                    iaddiu        VI07,VI09,0
         NOP                                    sqi           VF12,(VI06++)
vertexLoop:
         NOP                                    lq            VF07,0(VI03)
         NOP                                    lq            VF08,0(VI04)
         NOP                                    lq            VF09,0(VI05)
         mulax         ACC,VF01,VF07x           NOP
         madday        ACC,VF02,VF07y           NOP
         maddaz        ACC,VF03,VF07z           NOP
         maddw         VF07,VF04,VF07w          NOP
         NOP                                    div           Q,VF00w,VF07w
         mulx.w        VF07,VF07,VF11x          NOP
         addy.w        VF07,VF07,VF11y          NOP
         maxx.w        VF07,VF07,VF00x          NOP
         miniz.w       VF07,VF07,VF11z          NOP
         NOP                                    waitq
         mulq.xyz      VF07,VF07,Q              NOP
         mulq          VF08,VF08,Q              NOP
         mul.xyz       VF07,VF07,VF05           NOP
         add.xyz       VF07,VF07,VF06           NOP
         ftoi4         VF07,VF07                NOP
         NOP                                    sq            VF08,0(VI06)
         NOP                                    sq            VF09,1(VI06)
         NOP                                    sq            VF07,2(VI06)
         NOP                                    iaddiu        VI06,VI06,3
         NOP                                    iaddiu        VI03,VI03,1
         NOP                                    iaddiu        VI04,VI04,1
         NOP                                    iaddiu        VI05,VI05,1
         NOP                                    isubiu        VI07,VI07,1
         NOP                                    NOP
         NOP                                    ibne          VI07,VI00,vertexLoop
         NOP                                    NOP
         NOP                                    xgkick        VI08
         NOP[E]                                 NOP
         NOP                                    NOP
		.align 4
VU1Scene_CodeEnd:
